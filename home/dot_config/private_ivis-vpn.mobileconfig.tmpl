	<key>PayloadUUID</key>
	<string>BB202F76-741C-4957-A63D-3C7329725426</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadScope</key>
	<string>User</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
</dict>
</plist>
